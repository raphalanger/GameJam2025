[sub_resource type="GDScript" id="GDScript_cy4oq"]
script/source = "extends Area2D

@export var next_scene_path: String = \"res://scenes/3d/startarea/startarea2.tscn\"
var inside_bodies := []

# Velocidade do fade (em segundos)
@export var fade_time: float = 1.0

# Referência para o nó de fade (ex: um ColorRect preto na tela)
@onready var fade_rect := get_tree().root.get_node(\"FadeLayer/ColorRect\")

func _ready():
	connect(\"body_entered\", Callable(self, \"_on_body_entered\"))
	connect(\"body_exited\", Callable(self, \"_on_body_exited\"))

func _on_body_entered(body):
	if body.name == \"player\" and not body in inside_bodies:
		inside_bodies.append(body)
		await fade_out()
		get_tree().change_scene_to_file(next_scene_path)

func _on_body_exited(body):
	if body in inside_bodies:
		inside_bodies.erase(body)

# Função para fazer o fade-out
func fade_out():
	if not fade_rect:
		push_warning(\"Nenhum ColorRect encontrado para fade!\")
		return
	fade_rect.visible = true
	var tween = create_tween()
	tween.tween_property(fade_rect, \"modulate:a\", 1.0, fade_time)
	await tween.finished
"

